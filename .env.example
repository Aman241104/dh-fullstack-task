# Required — the app won't build/run without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required only for the test suite (tests/*.test.ts real-session integration
# tests skip themselves automatically when these aren't set).
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_MEMBER_EMAIL=
TEST_MEMBER_PASSWORD=

# Optional — AI lead scoring + the AI Copilot degrade to their deterministic
# fallback (scoring) or a "not configured" reply (Copilot) without this, so
# the app still runs fully without it.
NVIDIA_API_KEY=

# Optional — new-lead email notifications are skipped (logged, not thrown)
# without these. RESEND_NOTIFY_EMAIL is the fallback recipient used when no
# admin has set an alert email in Settings.
RESEND_API_KEY=
RESEND_NOTIFY_EMAIL=

# Optional — Sentry error tracking is disabled without this (Sentry.init's
# `enabled` flag checks for it explicitly).
NEXT_PUBLIC_SENTRY_DSN=
